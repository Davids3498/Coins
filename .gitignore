# Raw dataset (images, embeddings cache, source archives) + root compat symlink
FOR_TRAINNING
/data/FOR_TRAINNING/
/data/archives/

# Model checkpoints / exported weights
weights/
*.pth
*.onnx

# Generated outputs / loose images
outputs/
misclassified
prediction_result.png
*.jpg
*.jpeg
*.png
# ...except figures the README embeds. Tracked deliberately: a screenshot of a
# generated Evidently report is evidence the drift check ran, and outputs/ itself
# stays ignored, so the only way one reaches the repo is by being copied here.
!docs/img/*.png

# MLflow local tracking store
mlflow.db

# Scratch / throwaway files
scratch/
misc/

# Python
__pycache__/
*.pyc
# setuptools leaves build/ behind after a wheel/sdist build; nothing in it is source.
/build/
/dist/
# Regenerated by `pip install -e .` (the documented dev/CI install), so tracking it means
# every contributor who follows requirements-dev.txt gets a dirty tree. The copy that was
# tracked had already gone stale -- it listed neither hashing.py nor prediction_log.py.
*.egg-info/
.ipynb_checkpoints/

# Tool caches. Each of these tools writes a self-ignoring .gitignore into its own cache dir,
# so the tree was already clean -- listing them here means the ignore survives a tool that
# stops doing that, and it documents what these directories are to anyone reading the tree.
.mypy_cache/
.pytest_cache/
.ruff_cache/

# OS
.DS_Store

# Docs — working notes stay local. The README was split into these seven reference pages
# (see "Repo map"), so each is un-ignored BY NAME rather than with a blanket !docs/*.md:
# the un-listed files in docs/ are scratch (v4_deep_dive, program, notebook_summary,
# improvement_or_not) and should keep staying out of the repo.
*.md
!README.md
!docs/dataset.md
!docs/pipeline.md
!docs/serving.md
!docs/cloud-deploy.md
!docs/engineering-notes.md
!docs/development.md
!docs/model-history.md

# makefile is tracked: it carries the serving container's outputs/monitoring volume mount,
# without which /predict logs into a --rm container and the drift check has nothing to read.

.venv-airflow/
.airflow/