# Raw dataset (images, embeddings cache, source archives) + root compat symlink
FOR_TRAINNING
/data/FOR_TRAINNING/
/data/archives/

# Model checkpoints / exported weights
weights/
*.pth
*.onnx

# Generated outputs / loose images
outputs/
misclassified
prediction_result.png
*.jpg
*.jpeg
*.png

# MLflow local tracking store
mlflow.db

# Scratch / throwaway files
scratch/
misc/

# Python
__pycache__/
*.pyc
# Regenerated by `pip install -e .` (the documented dev/CI install), so tracking it means
# every contributor who follows requirements-dev.txt gets a dirty tree. The copy that was
# tracked had already gone stale -- it listed neither hashing.py nor prediction_log.py.
*.egg-info/
.ipynb_checkpoints/

# OS
.DS_Store

# Docs — keep only README.md, working notes stay local
*.md
!README.md

# makefile is tracked: it carries the serving container's outputs/monitoring volume mount,
# without which /predict logs into a --rm container and the drift check has nothing to read.

.venv-airflow/
.airflow/